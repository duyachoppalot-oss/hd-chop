{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/api",
        "run",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/mobile",
        "run",
        "web",
        "--",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/admin",
        "run",
        "dev"
      ],
      "port": 3002
    },
    {
      "name": "mobile-web-local-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_API_URL=http://localhost:3001",
        "npm",
        "--prefix",
        "apps/mobile",
        "run",
        "web",
        "--",
        "--port",
        "8083"
      ],
      "port": 8083
    }
  ]
}
