{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "20.20.1",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hdchop.5.161.100.126.nip.io"
      }
    },
    "simulator": {
      "extends": "base",
      "ios": { "simulator": true }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal"
    },
    "production": {
