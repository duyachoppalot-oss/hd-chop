# Local dev reaches Postgres through an SSH tunnel (scripts/dev/db-tunnel.sh):
# 127.0.0.1:55432 here -> 127.0.0.1:5432 on the DB server, so any network works
# (hotspot, new Wi-Fi) with no pg_hba change. `npm run dev` in apps/admin and
# apps/api starts it; run it yourself before ETL scripts or psql.
# Existing catalog DB — READ-ONLY role
SOURCE_DATABASE_URL=postgres://readonly_user:***@127.0.0.1:55432/catalog
# New app DB
APP_DATABASE_URL=postgres://hdchop_user:***@127.0.0.1:55432/hdchop
